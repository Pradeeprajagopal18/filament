# Copy to .env (git ignores it) and fill in what you need. docker compose and the backend
# (run from backend/, which reads backend/.env) both read these.

# Model access. Leave empty to run agents offline (scans, code graph and checks still work).
ANTHROPIC_API_KEY=
# A company gateway in front of the Anthropic API, if you have one.
# ANTHROPIC_BASE_URL=https://llm-gateway.example.com

# Private GitHub repos and GitHub features (issues, PRs, CI). A fine-grained, read-only token.
# If your org uses single sign-on, authorize the token for the org.
FILAMENT_GIT_TOKEN=
# GitHub Enterprise Server: add your host so the token is used there (and nowhere else).
# FILAMENT_GITHUB_HOSTS=["github.com","github.yourcompany.com"]
# Very large repos: clone time limit in seconds (or onboard a local clone instead).
# FILAMENT_CLONE_TIMEOUT_S=600

# Sign-in with the company SSO (OpenID Connect). Leave unset on a laptop (no sign-in).
# FILAMENT_AUTH_MODE=oidc
# FILAMENT_OIDC_ISSUER=https://acme.okta.com/oauth2/default
# FILAMENT_OIDC_CLIENT_ID=
# FILAMENT_OIDC_CLIENT_SECRET=
# FILAMENT_OIDC_GITHUB_CLAIM=github_username
# FILAMENT_SESSION_SECRET=change-me-to-a-long-random-string
# FILAMENT_ADMIN_EMAILS=["you@acme.com"]
# FILAMENT_UI_URL=https://filament.acme.internal

# Corporate network (only if you need them).
# HTTPS_PROXY=http://proxy.example.com:8080
# HTTP_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1,db,api
# PIP_INDEX_URL=https://artifactory.example.com/api/pypi/pypi/simple
